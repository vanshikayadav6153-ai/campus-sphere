# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend.vercel.app

# Allowed Institutional Domain (default: college.ac.in)
ALLOWED_DOMAIN=college.ac.in

# Database (MongoDB Atlas Connection String)
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/campussphere?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback
